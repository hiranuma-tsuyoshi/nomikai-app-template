# Supabase
# Supabase Dashboard > Project Settings > API から取得
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Game
# 本番では必ず変更する（司会者画面のログインキー）
HOST_KEY=
# 参加者が入力するルームコード
ROOM_CODE=4821
# チーム数と1チームの定員
TEAM_COUNT=5
TEAM_CAPACITY=7
# スクリーンURLに token を必須にする（本番推奨: 1）
STAGE_REQUIRE_TOKEN=1

# Advanced (optional)
# Supabase の game_states 行を識別するキー（既定: default）
# GAME_ROOM_KEY=default
# Supabase 未設定時のファイル保存先（既定: .data/game-state.json）
# GAME_STATE_FILE=.data/game-state.json
